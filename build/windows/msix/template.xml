<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="Veda"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\Veda">
    </Installer>
    <PackageInformation
        PackageName="Veda"
        PackageDisplayName="Veda"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.1.0"
        PackageDescription="A WYSIWYG markdown editor">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.jiangling.veda"
                Description="A WYSIWYG markdown editor"
                DisplayName="Veda"
                ExecutableName="Veda"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Veda</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>A WYSIWYG markdown editor</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="Veda.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
